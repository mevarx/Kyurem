# Keep the Docker build context small and free of local state.
#
# The images need the Go module they build (gateway/ or demo/) and, for the
# dashboard, api/ (the OpenAPI contract the types are generated from) plus
# dashboard/ itself. Everything else is excluded here.

.git
.github
.gitignore
.dockerignore

# Build outputs and local state
bin
demo/bin
**/node_modules
**/*.exe
**/*.test
**/*.out
**/*.log
**/*.pid
dashboard/dist
dashboard/coverage
dashboard/.vite

# Local secrets
.env
.env.*
deploy/compose/.env
*.pem
*.key

# Not needed inside the images
docs
tmp
