# Kyurem .gitignore

# Build outputs
/bin/
bin/
/demo/bin/
*.exe
*.out
*.test
# Only the root-level binary: a bare "kyurem" pattern would also match
# gateway/cmd/kyurem/ and silently drop the gateway entrypoint.
/kyurem

# Logs and runtime artifacts
*.log
gateway.log
gateway.err.log
*.pid
*.sock

# Local secrets / environment overrides (compose, OTLP credentials)
/.env
.env.*
!/.env.example
!dashboard/.env.example
deploy/compose/.env
*.pem
*.key
secrets/

# Go
*.coverprofile
coverage.out
/vendor/

# Test reports and coverage artifacts from local or CI runs
coverage/
test-results/
*.junit.xml

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Node / dashboard (M3)
node_modules/
dashboard/dist/
dashboard/.next/
dashboard/.vite/
dashboard/*.tsbuildinfo
dashboard/.eslintcache
npm-debug.log*
yarn-error.log*

# Python demo agents (land in a later milestone)
__pycache__/
*.py[cod]
.pytest_cache/
.venv/

# Benchmark artifacts (M4)
demo/bin/bench-results/
*.prof
*.pprof
*.trace

# Temporary / scratch
*.tmp
/tmp/

# Database files (local stores)
*.db
*.db-wal
*.db-shm

# Source documents not committed
Kyurem Product Requirements Document.md
