# Kyurem .gitignore

# Build outputs
/bin/
bin/
/demo/bin/
*.exe
*.out
*.test
kyurem

# Logs and runtime artifacts
*.log
gateway.log
gateway.err.log
*.pid
*.sock

# Local secrets / environment overrides (compose, OTLP credentials)
/.env
.env.*
!/.env.example
deploy/compose/.env
*.pem
*.key
secrets/

# Go
*.coverprofile
coverage.out
/vendor/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Node / dashboard (lands in M3)
node_modules/
dashboard/dist/
dashboard/.next/
dashboard/coverage/

# Python demo agents (land in a later milestone)
__pycache__/
*.py[cod]
.pytest_cache/
.venv/

# Temporary / scratch
*.tmp
/tmp/

# Source documents not committed
Kyurem Product Requirements Document.md
