# Base URL of the Kyurem management API.
# The compose stack proxies /api to the gateway's management listener, so the
# same origin works. Override when the gateway runs somewhere else, e.g.
# VITE_KYUREM_API_BASE=http://127.0.0.1:8082/api
VITE_KYUREM_API_BASE=/api

# Optional bearer token for the management API (KYUREM_MANAGEMENT_AUTH_TOKEN).
# Leave empty when the gateway runs unauthenticated on loopback. A token typed
# into the Settings page is stored in localStorage and takes precedence.
VITE_KYUREM_API_TOKEN=
